@model List<ChartData>

@{
    ViewData["Title"] = "История диаграмм";
}

<h2>История диаграмм</h2>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Файл данных</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var chart in Model)
        {
            <tr>
                <td>@chart.Id</td>
                <td>
                    @if (!string.IsNullOrEmpty(chart.ChartImagePath)) // Проверка наличия пути к файлу
                    {
                        <a href="@Url.Content(chart.ChartImagePath)" download>Скачать файл JSON</a>
                    }
                    else
                    {
                        <span>Файл не прикреплен</span>
                    }
                </td>
                <td>
                    <button onclick="showChart(@chart.Id, '@chart.XValues', '@chart.YValues')">Посмотреть изображение</button>
                    <button onclick="deleteChart(@chart.Id)">Удалить</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<canvas id="chartCanvas" style="display: none; width: 400px; height: 400px;"></canvas>



@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function deleteChart(chartId) {
            if (confirm('Вы уверены, что хотите удалить эту диаграмму?')) {
                fetch("/Chart/Delete", {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest' // Это нужно для ASP.NET Core
                    },
                    body: JSON.stringify({ id: chartId })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.status === "success") {
                            alert(data.message);
                            location.reload(); // Обновление страницы после удаления
                        } else {
                            alert(data.message);
                        }
                    })
                    .catch(error => {
                        alert('Ошибка при удалении диаграммы: ' + error);
                    });
            }
        }

        function showChart(chartId, xValuesString, yValuesString) {

            // Отображение диаграммы с использованием Chart.js
            const ctx = document.getElementById('chartCanvas').getContext('2d');

            document.getElementById('chartCanvas').style.display = 'inline-block';


            // Преобразуем строки в массивы
            const xValues = JSON.parse(xValuesString);
            const yValues = JSON.parse(yValuesString);

            new Chart(ctx, {
                type: 'scatter',
                data: {
                    datasets: [{
                        label: 'Диаграмма',
                        data: xValues.map((x, index) => ({ x, y: yValues[index] })),
                        backgroundColor: 'rgba(75, 192, 192, 1)'
                    }]
                },
                options: {
                    scales: {
                        x: {
                            type: 'linear',
                            position: 'bottom'
                        }
                    }
                }
            });
        }



    </script>
}
