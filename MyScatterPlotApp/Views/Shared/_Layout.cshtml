<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyScatterPlotApp</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav>
            <ul>
                @if (User.Identity.IsAuthenticated)
                {
                    <li><a asp-controller="Chart" asp-action="Index">Создать диаграмму</a></li>
                    <li><a asp-controller="Chart" asp-action="History">История</a></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit">Выйти</button>
                        </form>
                    </li>
                }
                else
                {
                    <li><a asp-controller="Account" asp-action="Login">Войти</a></li>
                    <li><a asp-controller="Account" asp-action="Register">Регистрация</a></li>
                }
            </ul>
        </nav>
    </header>
    <div class="container">
        @RenderBody()
    </div>
    <footer>
        <p>&copy; 2024 - MyScatterPlotApp</p>
    </footer>
    @RenderSection("Scripts", required: false)
</body>
</html>
